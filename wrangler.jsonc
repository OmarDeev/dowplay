// Cloudflare Workers (static assets) — deploys the prebuilt Astro site in ./dist
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dowplay",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Serve /about from about.html, /play/x/ from play/x/index.html
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get dist/404.html with a real 404 status
    "not_found_handling": "404-page"
  }
}
