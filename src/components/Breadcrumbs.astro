---
interface Props {
  items: { label: string; href: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="crumbs">
  <ol>
    {
      items.map((item, i) => (
        <li>
          {i < items.length - 1 ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.88rem;
    color: var(--muted);
  }
  li + li::before {
    content: '/';
    margin-right: 0.4rem;
    opacity: 0.5;
  }
  a {
    color: var(--muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--text);
  }
  [aria-current] {
    color: var(--text);
  }
</style>
