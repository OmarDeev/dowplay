---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { SITE } from '../config/site';
import { absoluteUrl, cleanPath } from '../lib/content';

export interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  jsonLd = [],
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = absoluteUrl(cleanPath(Astro.url.pathname));

// Social networks need a raster image with a known size
let ogImage = { src: absoluteUrl('/og-default.png'), width: 1200, height: 630 };
if (image) {
  const resized = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 82 });
  ogImage = {
    src: absoluteUrl(resized.src),
    width: Number(resized.attributes.width),
    height: Number(resized.attributes.height),
  };
}
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.ogLocale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage.src} />
<meta property="og:image:width" content={String(ogImage.width)} />
<meta property="og:image:height" content={String(ogImage.height)} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
<meta name="twitter:card" content="summary_large_image" />

{SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
