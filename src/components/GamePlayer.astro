---
import { Image } from 'astro:assets';
import type { Game } from '../lib/content';
import { gameEmbedUrl } from '../lib/content';

interface Props {
  game: Game;
}

const { game } = Astro.props;
const { title, cover, coverAlt, orientation, levels, saveKey } = game.data;
const src = gameEmbedUrl(game);
---

<!--
  The game plays in a frame, which keeps its own styles and scripts apart from the site's.
  It is only loaded when the player presses Play: the page stays fast (good Core Web Vitals
  = better ranking) and crawlers don't load game engines.

  - Big screens: the game plays in the page, as tall as the screen allows. Fullscreen uses the
    browser's real fullscreen, or fills the window where that isn't available.
  - Phones (and small windows): Play opens the game filling the screen straight away, so it
    never has to share the screen with the page or scroll inside it.
  - A link to the page with #play starts the game at once.
  - Returning players see "Continue" and how far they got (read from the game's saved progress).
-->
<game-player
  class:list={['player', orientation]}
  data-src={src}
  data-title={title}
  data-id={game.id}
  data-save-key={saveKey}
  data-levels={levels}
>
  <div class="stage">
    <Image
      src={cover}
      alt={coverAlt ?? `${title} game`}
      widths={[640, 960, 1280]}
      sizes="(max-width: 1240px) 100vw, 1200px"
      loading="eager"
      fetchpriority="high"
      class="poster"
    />
    <div class="overlay" data-overlay>
      <button type="button" class="btn btn-primary start" data-start>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.6-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"></path></svg>
        <span data-start-label>Play now</span>
        <span class="visually-hidden"> {title}</span>
      </button>
      <p class="note" data-note>{levels ? `${levels} levels · ` : ''}Free · No sign-up</p>
      <div class="progress" data-progress hidden>
        <span class="bar"><span data-progress-fill></span></span>
      </div>
    </div>
    <div class="loading" data-loading hidden>
      <span class="spinner" aria-hidden="true"></span>
      <span>Loading {title}…</span>
    </div>
    <div class="resume" data-resume hidden>
      <button type="button" class="btn btn-primary" data-resume-button>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.6-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"></path></svg>
        Continue playing
      </button>
    </div>
  </div>
  <div class="controls">
    <span class="bar-title">{title}</span>
    <span class="hint" data-hint>Free · No sign-up · Works on Chromebooks, tablets and phones</span>
    <button type="button" class="btn btn-ghost fullscreen" aria-pressed="false" data-fullscreen>
      <svg class="enter" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
      <svg class="exit" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5"></path></svg>
      <span data-fullscreen-label>Fullscreen</span>
    </button>
  </div>
</game-player>

<script>
  import { track } from '../lib/analytics';
  import { readProgress } from '../lib/progress';

  // Phones, and windows too small to play in alongside the page
  const SMALL = window.matchMedia('(max-width: 760px), (max-height: 520px)');

  type WebkitDocument = Document & {
    webkitFullscreenEnabled?: boolean;
    webkitFullscreenElement?: Element;
    webkitExitFullscreen?: () => void;
  };
  type WebkitElement = HTMLElement & { webkitRequestFullscreen?: () => void };
  const doc = document as WebkitDocument;

  class GamePlayer extends HTMLElement {
    connectedCallback() {
      const $ = <T extends HTMLElement>(name: string) => this.querySelector<T>(`[data-${name}]`)!;
      const stage = this.querySelector<HTMLElement>('.stage')!;
      const overlay = $('overlay');
      const loading = $('loading');
      const resume = $('resume');
      const fullscreen = $<HTMLButtonElement>('fullscreen');
      const fullscreenLabel = $('fullscreen-label');
      const src = this.dataset.src!;
      const name = this.dataset.title ?? 'Game';
      const levels = Number(this.dataset.levels) || 0;
      const progress = readProgress(this.dataset.saveKey, levels);
      let frame: HTMLIFrameElement | null = null;
      let expanded = false; // filling the window ourselves
      let addedHistory = false;

      // Returning player: "Continue" and how far they got
      if (progress) {
        $('start-label').textContent = 'Continue';
        $('note').textContent = `Level ${progress.level} of ${levels} · ★ ${progress.stars} of ${levels * 3}`;
        $('progress').hidden = false;
        $('progress-fill').style.width = `${Math.round((progress.done / levels) * 100)}%`;
      }

      const inRealFullscreen = () => (doc.fullscreenElement ?? doc.webkitFullscreenElement) === this;
      const update = () => {
        const on = expanded || inRealFullscreen();
        this.classList.toggle('expanded', expanded);
        this.classList.toggle('is-full', on);
        document.documentElement.classList.toggle('game-expanded', expanded);
        fullscreen.setAttribute('aria-pressed', String(on));
        fullscreenLabel.textContent = on ? 'Exit fullscreen' : 'Fullscreen';
        // On a small screen the game is only played full-window; in the page it waits behind
        // a "Continue playing" button (scrolling a game inside a scrolling page fights the finger).
        resume.hidden = !frame || on || !SMALL.matches;
      };

      const load = () => {
        if (frame) return;
        frame = document.createElement('iframe');
        frame.src = src;
        frame.title = name;
        frame.allow = 'autoplay; fullscreen; gamepad; accelerometer; gyroscope; screen-wake-lock';
        frame.allowFullscreen = true;
        frame.addEventListener('load', () => {
          loading.hidden = true;
          this.classList.add('ready');
          frame!.focus();
        });
        overlay.hidden = true;
        loading.hidden = false;
        stage.append(frame);
        this.classList.add('playing');
        $('hint').textContent = 'Short on space? Press Fullscreen.';
        track('game_start', { game_name: name, game_id: this.dataset.id ?? '', returning: progress ? 'yes' : 'no' });
      };

      const expand = () => {
        if (expanded) return;
        expanded = true;
        // So the phone's Back gesture closes the full-window view instead of leaving the page
        history.pushState({ dowplayFullWindow: true }, '');
        addedHistory = true;
        update();
        frame?.focus();
      };
      const collapse = (fromBack = false) => {
        if (!expanded) return;
        expanded = false;
        update();
        if (addedHistory && !fromBack) history.back();
        addedHistory = false;
        // After the browser restores its own scroll position for the history step
        setTimeout(() => this.scrollIntoView({ block: 'start' }), 60);
      };

      const play = () => {
        load();
        if (SMALL.matches) {
          expand();
        } else {
          // The game gets the full height of the screen, so bring all of it into view.
          const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          this.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'start' });
        }
      };

      $('start').addEventListener('click', play);
      $('resume-button').addEventListener('click', expand);

      fullscreen.addEventListener('click', async () => {
        if (expanded) return collapse();
        if (inRealFullscreen()) {
          if (doc.exitFullscreen) doc.exitFullscreen().catch(() => {});
          else doc.webkitExitFullscreen?.();
          return;
        }
        track('game_fullscreen', { game_name: name, game_id: this.dataset.id ?? '' });
        load();
        const el = this as WebkitElement;
        if (!SMALL.matches && doc.fullscreenEnabled && el.requestFullscreen) {
          try {
            await el.requestFullscreen();
            return;
          } catch {
            // refused (e.g. inside some app browsers): fill the window instead
          }
        } else if (!SMALL.matches && doc.webkitFullscreenEnabled && el.webkitRequestFullscreen) {
          el.webkitRequestFullscreen();
          return;
        }
        expand();
      });

      // Leaving real fullscreen: bring the game back into view where the page left off
      let wasReal = false;
      const onFullscreenChange = () => {
        const now = inRealFullscreen();
        if (wasReal && !now) setTimeout(() => this.scrollIntoView({ block: 'start' }), 60);
        wasReal = now;
        update();
      };
      document.addEventListener('fullscreenchange', onFullscreenChange);
      document.addEventListener('webkitfullscreenchange', onFullscreenChange);
      SMALL.addEventListener('change', update);
      window.addEventListener('popstate', () => collapse(true));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && expanded) collapse();
      });

      // /games/<slug>#play starts straight away (used by the Play buttons around the site)
      if (location.hash === '#play') {
        history.replaceState(history.state, '', location.pathname + location.search);
        play();
      }
    }
  }
  customElements.define('game-player', GamePlayer);
</script>

<style>
  .player {
    display: block;
    scroll-margin-top: 4.75rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #0b0d17;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
  }
  .stage {
    position: relative;
    aspect-ratio: 16 / 9;
    max-height: 78vh;
    margin-inline: auto;
    background: #0b0d17;
  }
  .portrait .stage {
    aspect-ratio: 9 / 16;
    height: min(78vh, 760px);
  }
  /* Once playing on a big screen, a landscape game fills the screen height (minus the site
     header and the bar below), which suits games with a side panel. */
  @media (min-width: 761px) and (min-height: 521px) {
    .playing:not(.portrait) .stage {
      aspect-ratio: auto;
      height: clamp(460px, calc(100svh - 8.75rem), 900px);
      max-height: none;
    }
  }
  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.62) saturate(1.1);
  }
  .ready .poster {
    display: none;
  }
  .overlay,
  .loading,
  .resume {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    padding: 1rem;
    text-align: center;
  }
  .overlay {
    background: radial-gradient(circle at center, rgb(11 13 23 / 0.15) 0 30%, rgb(11 13 23 / 0.55));
  }
  .overlay[hidden],
  .loading[hidden],
  .resume[hidden] {
    display: none;
  }
  .start {
    font-size: 1.15rem;
    padding: 1rem 1.8rem;
    box-shadow:
      0 0 0 8px rgb(61 90 254 / 0.35),
      0 12px 30px -8px rgb(0 0 0 / 0.8);
    animation: pulse 2.4s ease-in-out infinite;
  }
  .start svg,
  .resume svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: currentColor;
  }
  @keyframes pulse {
    50% {
      box-shadow:
        0 0 0 16px rgb(61 90 254 / 0.12),
        0 12px 30px -8px rgb(0 0 0 / 0.8);
    }
  }
  .note {
    margin: 0.35rem 0 0;
    padding: 0.25rem 0.8rem;
    border-radius: 999px;
    background: rgb(11 13 23 / 0.55);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 650;
  }
  .progress {
    width: min(220px, 60vw);
  }
  .progress[hidden] {
    display: none;
  }
  .bar {
    display: block;
    height: 6px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.25);
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--brand);
  }
  .loading {
    color: #dfe3f3;
    font-weight: 650;
    background: rgb(11 13 23 / 0.45);
  }
  .spinner {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 4px solid rgb(255 255 255 / 0.2);
    border-top-color: var(--brand);
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .spinner {
      animation: none !important;
      border-top-color: rgb(255 255 255 / 0.2);
    }
  }
  .resume {
    background: rgb(11 13 23 / 0.6);
  }
  .stage :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0.75rem 0.6rem 1.1rem;
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  .bar-title {
    display: none;
    font-family: var(--font-display);
    font-weight: 750;
  }
  .hint {
    color: var(--muted);
    font-size: 0.88rem;
  }
  .fullscreen {
    margin-left: auto;
    padding: 0.45rem 0.9rem;
    font-size: 0.88rem;
  }
  .fullscreen svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .fullscreen .exit,
  .is-full .fullscreen .enter {
    display: none;
  }
  .is-full .fullscreen .exit {
    display: block;
  }
  .is-full .bar-title {
    display: block;
  }
  .is-full .hint {
    display: none;
  }
  /* Full-window mode: cover the whole page */
  .player.expanded {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100dvh;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .player.expanded .stage {
    flex: 1;
    width: 100%;
    height: auto;
    max-height: none;
    aspect-ratio: auto;
  }
  .player.expanded .controls {
    padding-bottom: max(0.6rem, env(safe-area-inset-bottom));
  }
  :global(html.game-expanded),
  :global(html.game-expanded body) {
    overflow: hidden;
  }
  /* Real fullscreen: let the game fill the screen */
  .player:fullscreen {
    border: 0;
    border-radius: 0;
    display: flex;
    flex-direction: column;
  }
  .player:fullscreen .stage {
    flex: 1;
    width: 100%;
    max-height: none;
    height: auto;
    aspect-ratio: auto;
  }
  @media (max-width: 560px) {
    .start {
      font-size: 1.05rem;
      padding: 0.85rem 1.5rem;
    }
    .hint {
      display: none;
    }
  }
</style>
