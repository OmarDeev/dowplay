---
/**
 * A small line icon for each engineering topic (decorative: always aria-hidden).
 * Colour comes from `currentColor`.
 */
import type { CategoryKey } from '../config/categories';

interface Props {
  topic: CategoryKey;
  class?: string;
}

const { topic, class: className } = Astro.props;
---

<svg
  class:list={['topic-icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {topic === 'electricity' && <path d="M13 2.5 4.5 13.5H11l-1 8 8.5-11H12l1-8Z" />}
  {
    topic === 'mechanics' && (
      <>
        <circle cx="12" cy="12" r="3" />
        <path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" />
        <circle cx="12" cy="12" r="6.9" />
      </>
    )
  }
  {
    topic === 'structures' && (
      <>
        <path d="M2 17.5h20" />
        <path d="M3.5 17.5 7.5 10h9l4 7.5" />
        <path d="M7.5 10l4.5 7.5 4.5-7.5" />
      </>
    )
  }
  {
    topic === 'energy' && (
      <>
        <path d="M12 11v10.5M9 21.5h6" />
        <path d="M12 11 11.2 3.2c.4-.9 1.2-.9 1.6 0L12 11Z" />
        <path d="M12 11l6.6 4.3c.5.8.1 1.5-.8 1.4L12 11Z" />
        <path d="M12 11l-6.6 4.3c-.5.8-.1 1.5.8 1.4L12 11Z" />
        <circle cx="12" cy="11" r="1.2" />
      </>
    )
  }
</svg>
