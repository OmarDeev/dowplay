---
import { Image } from 'astro:assets';
import TopicIcon from './TopicIcon.astro';
import { CATEGORIES } from '../config/categories';
import { audienceOf, gameUrl, type Game } from '../lib/content';

interface Props {
  game: Game;
  eager?: boolean;
  /** Heading level for the title, so cards fit the page outline */
  as?: 'h2' | 'h3';
}

const { game, eager = false, as: Heading = 'h3' } = Astro.props;
const { title, tagline, cover, coverAlt, category, years, levels, teacherPack, saveKey } = game.data;
const who = audienceOf(years);
---

<a class="card" href={gameUrl(game)} data-topic={category} data-save-key={saveKey} data-levels={levels}>
  <div class="thumb">
    <Image
      src={cover}
      alt={coverAlt ?? `${title} cover art`}
      widths={[320, 480, 640]}
      sizes="(max-width: 560px) 92vw, (max-width: 1000px) 46vw, 290px"
      loading={eager ? 'eager' : 'lazy'}
    />
    <span class="mine" data-card-progress hidden></span>
    <span class="play" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.6-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"></path></svg>
      Play
    </span>
  </div>
  <div class="body">
    <span class="chip" data-topic={category}><TopicIcon topic={category} />{CATEGORIES[category].label}</span>
    <Heading class="title">{title}</Heading>
    {tagline && <p class="tagline">{tagline}</p>}
    <ul class="facts" role="list">
      {who && <li>{who.years}</li>}
      {who && <li>{who.ages}</li>}
      {levels && <li>{levels} levels</li>}
    </ul>
    {
      teacherPack && (
        <span class="pack">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
            <path d="M14 3v5h5M9 13h6M9 17h4" />
          </svg>
          Free teacher pack
        </span>
      )
    }
  </div>
</a>

<script>
  import { readProgress } from '../lib/progress';

  // Returning players see their stars on the games they've played
  for (const badge of document.querySelectorAll<HTMLElement>('[data-card-progress]')) {
    const card = badge.closest<HTMLElement>('[data-save-key]');
    const levels = Number(card?.dataset.levels) || 0;
    const progress = readProgress(card?.dataset.saveKey, levels);
    if (!progress) continue;
    badge.innerHTML = `<span aria-hidden="true">★</span> ${progress.stars}/${levels * 3}<span class="visually-hidden"> stars so far</span>`;
    badge.title = `You're on level ${progress.level} of ${levels}`;
    badge.hidden = false;
  }
</script>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    color: var(--text);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.2s,
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .card:hover,
  .card:focus-visible {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--topic) 55%, var(--line));
    box-shadow: var(--shadow-lg);
  }
  .thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--topic-soft);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .card:hover .thumb img {
    transform: scale(1.04);
  }
  .mine {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--brand);
    color: var(--brand-ink);
    font-size: 0.8rem;
    font-weight: 800;
    box-shadow: 0 4px 12px -4px rgb(20 26 46 / 0.6);
  }
  .mine[hidden] {
    display: none;
  }
  .play {
    position: absolute;
    right: 0.7rem;
    bottom: 0.7rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem 0.4rem 0.7rem;
    border-radius: 999px;
    background: var(--primary);
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    box-shadow: 0 8px 18px -8px rgb(20 26 46 / 0.7);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.2s,
      transform 0.2s;
  }
  .play svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: currentColor;
  }
  .card:hover .play,
  .card:focus-visible .play {
    opacity: 1;
    transform: none;
  }
  .body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    flex: 1;
    padding: 0.95rem 1rem 1rem;
  }
  .title {
    margin: 0.1rem 0 0;
    font-size: 1.2rem;
  }
  .tagline {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.9rem;
    list-style: none;
    margin: auto 0 0;
    padding: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 600;
  }
  .facts li {
    white-space: nowrap;
  }
  .facts li + li::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    margin: 0 0.6rem 0.2em -0.6rem;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .pack {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ok);
    font-size: 0.82rem;
    font-weight: 700;
  }
  .pack svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
