---
import { Image } from 'astro:assets';
import StoreButtons from './StoreButtons.astro';
import type { App } from '../lib/content';

interface Props {
  app: App;
}

const { app } = Astro.props;
const { name, summary, icon, genre, appStoreUrl, googlePlayUrl, webUrl } = app.data;
---

<article class="app">
  <div class="head">
    <Image src={icon} alt={`${name} app icon`} width={88} height={88} densities={[1, 2]} class="icon" />
    <div>
      <h3>{name}</h3>
      <span class="chip">{genre}</span>
    </div>
  </div>
  <p>{summary}</p>
  <StoreButtons appStoreUrl={appStoreUrl} googlePlayUrl={googlePlayUrl} webUrl={webUrl} name={name} size="sm" />
</article>

<style>
  .app {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: 1.4rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--line);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .icon {
    width: 88px;
    height: 88px;
    border-radius: 22%;
    flex: none;
    box-shadow: 0 8px 20px -8px rgb(0 0 0 / 0.6);
  }
  h3 {
    margin: 0 0 0.35rem;
    font-size: 1.3rem;
  }
  p {
    margin: 0;
    color: var(--muted);
    flex: 1;
  }
</style>
