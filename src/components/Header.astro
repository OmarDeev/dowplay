---
import Logo from './Logo.astro';
import TopicIcon from './TopicIcon.astro';
import { NAV, SITE } from '../config/site';
import { CATEGORIES } from '../config/categories';
import { categoryUrl, cleanPath, getGames } from '../lib/content';

const path = cleanPath(Astro.url.pathname);
const isActive = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/games') : path.startsWith(href);
const topics = [...new Set((await getGames()).map((g) => g.data.category))];
const onTopic = path.startsWith('/category');
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="home" aria-label={`${SITE.name} home`}><Logo /></a>
    <nav aria-label="Main">
      <ul>
        {
          NAV.map((item, i) => (
            <>
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
              {i === 0 && topics.length > 0 && (
                <li class="has-menu">
                  <details class="menu" data-menu>
                    <summary class:list={{ current: onTopic }}>
                      Topics
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m6 9 6 6 6-6" />
                      </svg>
                    </summary>
                    <div class="drop">
                      {topics.map((key) => (
                        <a
                          href={categoryUrl(key)}
                          data-topic={key}
                          aria-current={path === categoryUrl(key) ? 'page' : undefined}
                        >
                          <span class="ic">
                            <TopicIcon topic={key} />
                          </span>
                          <span class="txt">
                            <strong>{CATEGORIES[key].label}</strong>
                            <small>{CATEGORIES[key].blurb}</small>
                          </span>
                        </a>
                      ))}
                    </div>
                  </details>
                </li>
              )}
            </>
          ))
        }
      </ul>
    </nav>
    <a class="btn btn-primary cta" href="/teachers#teacher-packs">Free teacher packs</a>
  </div>
</header>

<script>
  // Close the Topics menu on outside click or Escape.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-menu]')) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.86);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 4rem;
  }
  .home {
    text-decoration: none;
    margin-right: auto;
  }
  ul {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a,
  summary {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    font-weight: 650;
    font-size: 0.95rem;
    cursor: pointer;
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  summary {
    list-style: none;
    user-select: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s;
  }
  .menu[open] summary svg {
    transform: rotate(180deg);
  }
  nav > ul > li > a:hover,
  summary:hover,
  .menu[open] summary {
    color: var(--text);
    background: var(--bg-soft);
  }
  nav > ul > li > a[aria-current='page'],
  summary.current {
    color: var(--primary-ink);
    background: var(--primary-soft);
  }
  .has-menu {
    position: relative;
  }
  .drop {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%);
    width: 300px;
    padding: 0.5rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
    animation: drop 0.15s ease-out;
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translate(-50%, -6px);
    }
  }
  .drop a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.65rem;
    border-radius: 12px;
    color: var(--text);
  }
  .drop a:hover,
  .drop a[aria-current='page'] {
    background: var(--topic-soft);
  }
  .ic {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 10px;
    background: var(--topic-soft);
    color: var(--topic-ink);
  }
  .drop a:hover .ic {
    background: var(--surface);
  }
  .ic :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
  }
  .txt {
    display: grid;
    line-height: 1.3;
  }
  .txt strong {
    font-size: 0.95rem;
  }
  .txt small {
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 500;
  }
  .cta {
    padding: 0.55rem 1.05rem;
    font-size: 0.9rem;
  }
  @media (max-width: 900px) {
    .cta {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .drop {
      position: fixed;
      top: 4.25rem;
      left: 0.75rem;
      right: 0.75rem;
      width: auto;
      transform: none;
      animation: none;
    }
  }
  @media (max-width: 440px) {
    .bar {
      gap: 0.25rem;
    }
    .bar :global(.word) {
      font-size: 1.1rem;
    }
    .bar :global(.mark) {
      width: 1.65rem;
      height: 1.65rem;
    }
    ul {
      gap: 0;
    }
    nav a,
    summary {
      padding: 0.45rem 0.4rem;
      font-size: 0.86rem;
    }
    summary svg {
      width: 0.85rem;
      height: 0.85rem;
    }
  }
  @media (max-width: 380px) {
    .bar :global(.word) {
      display: none;
    }
  }
</style>
